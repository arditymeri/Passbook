# Passbook environment configuration — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored; this file is tracked and must never contain a real value.
#
# ⚠ IF YOU ARE UPGRADING an instance created before v0.1.0: the database password this project
# used to ship is in its published git history. Removing it from the source
# does NOT remove it from history, and history rewriting on a public repository is not something
# you can rely on. ROTATE it — set a new password here and change it on the database itself —
# rather than assuming removal was enough. See docs/UPGRADING.md.

# ---------------------------------------------------------------------------
# Required — no default. The app refuses to start without these.
# ---------------------------------------------------------------------------

# Password for the PostgreSQL role Passbook connects as.
POSTGRES_PASSWORD=

# Signs session tokens. Any long random string; it is hashed to a 256-bit key.
# Generate one with:  openssl rand -base64 32
# Changing it logs every existing session out, which is the correct response to a leak.
JWT_SECRET=

# Password for the pgAdmin web UI at http://localhost:5050 (development convenience only —
# pgAdmin is not needed to run Passbook).
PGADMIN_DEFAULT_PASSWORD=

# ---------------------------------------------------------------------------
# Optional — sensible defaults shown. Not secrets.
# ---------------------------------------------------------------------------

# PostgreSQL role name. If you are UPGRADING an existing instance, leave this as `diti`: that is
# the role your database already has, and changing it will break the connection. A fresh install
# may use anything.
#POSTGRES_USER=diti

# Database name. Same warning as above — an existing instance already has `myfinance`.
#POSTGRES_DB=myfinance

# JDBC URL the backend connects to. The default targets the Compose service named `postgres`.
# Running the backend on your host instead (README Option B) needs localhost:
#DATABASE_URL=jdbc:postgresql://localhost:5432/myfinance

# Login for the pgAdmin web UI.
#PGADMIN_DEFAULT_EMAIL=admin@example.com
