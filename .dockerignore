# Build output — must never be copied into the image: the OpenAPI generator
# runs with skipOverwrite=true, so a stale generated-sources tree would be
# kept instead of being regenerated from the YAML specs.
target/
**/target/

# Frontend build output / deps
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# VCS & IDE
.git/
.gitignore
.idea/
.vscode/
*.iml

# Agent / spec tooling
.agents/
.claude/
specs/

# Secrets — the Dockerfile does `COPY . .`, so an operator's local .env would
# otherwise be baked into the image layer and shipped with it.
.env
.env.*
!.env.example
